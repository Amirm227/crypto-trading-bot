# ==============================================================================
# CRYPTO TRADING BOT ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# COPY THIS FILE TO .env FOR LOCAL DEVELOPMENT ONLY.
# NEVER COMMIT .env TO VERSION CONTROL OR EXPOSE CREDENTIALS.
# ==============================================================================

# Application Runtime Environment: 'backtest', 'paper', 'live'
APP_ENV=paper
LOG_LEVEL=INFO

# PostgreSQL Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_NAME=trading_bot
DB_USER=postgres
DB_PASSWORD=placeholder_db_password
DATABASE_URL=postgresql+asyncpg://postgres:placeholder_db_password@localhost:5432/trading_bot

# Exchange Connection (Paper / Testnet by default)
# IMPORTANT: API Keys MUST have Withdrawal permissions DISABLED at exchange level.
EXCHANGE_ID=binance
EXCHANGE_API_KEY=placeholder_read_and_trade_only_api_key
EXCHANGE_API_SECRET=placeholder_api_secret_do_not_commit
EXCHANGE_PASSWORD=
EXCHANGE_SANDBOX=true

# Safety and Risk Policy Gating (NON-NEGOTIABLE DEFAULTS)
ENABLE_LIVE_TRADING=false
ALLOW_WITHDRAWALS=false
FUTURES_LEVERAGE=1
MARGIN_MODE=isolated
ALLOW_CROSS_MARGIN=false

# System Alerting (Optional Webhook / Monitoring endpoints)
ALERT_WEBHOOK_URL=
PROMETHEUS_METRICS_PORT=8000
